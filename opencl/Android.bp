// Pixel apps declare the OpenCL library under its Pixel name only,
// so expose the Adreno implementation through the same interface.
cc_library_shared {
    name: "libOpenCL-pixel",
    srcs: ["opencl_pixel.c"],
    shared_libs: [
        "libdl",
        "liblog",
    ],
    stl: "none",
    vendor: true,
}
